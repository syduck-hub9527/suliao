# 复制成 .env 再修改：cp .env.example .env
# .env 里有密码，只放在服务器上，永远不要提交到 GitHub。

# 网站密钥：换成一长串随机字符。生成方法（在服务器上执行）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=请换成随机生成的密钥

# 管理员账号：第一次启动时自动创建。之后改密码请在后台里改。
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=请换成一个强密码

# 调试模式：正式使用保持 false
DJANGO_DEBUG=false

# 允许访问的地址（目前只通过 SSH 隧道访问，保持默认即可）
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 网站在服务器本机监听的端口
WEB_PORT=8000

# 网站进程数（2G 内存的服务器保持 2 即可）
GUNICORN_WORKERS=2

# 安装 Python 库用的下载源（阿里云服务器默认用阿里云源）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
